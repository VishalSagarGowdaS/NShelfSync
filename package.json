  "description": "ShelfSync E-Commerce Platform — React + TypeScript + Express + Aiven PostgreSQL + Kafka + OpenSearch + Razorpay + WhatsApp AI",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
