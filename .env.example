# ==============================================================================
# ShelfSync Environment Configuration
# Copy this file to .env and provide your actual credentials
# ==============================================================================

# Node Environment & Server Port
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 1. AIVEN POSTGRESQL (Required)
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
# Or individual credentials:
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://avnadmin:your_aiven_pg_password@pg-shelfsync-your-project.aivencloud.com:15682/defaultdb?sslmode=require
PG_HOST=pg-shelfsync-your-project.aivencloud.com
PG_PORT=15682
PG_DATABASE=defaultdb
PG_USER=avnadmin
PG_PASSWORD=your_aiven_pg_password
PG_SSL=true

# ------------------------------------------------------------------------------
# 2. AIVEN APACHE KAFKA (Required)
# SASL_SSL or SSL connection for Aiven Kafka cluster
# ------------------------------------------------------------------------------
KAFKA_BROKERS=kafka-shelfsync-your-project.aivencloud.com:15684
KAFKA_CLIENT_ID=shelfsync-backend
KAFKA_GROUP_ID=shelfsync-consumer-group
KAFKA_SASL_MECHANISM=scram-sha-256
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=your_aiven_kafka_password
# Path or base64 PEM CA certificate provided by Aiven for Kafka SSL
KAFKA_CA_CERT=

# ------------------------------------------------------------------------------
# 3. AIVEN OPENSEARCH (Required)
# HTTPS endpoint with Basic Authentication
# ------------------------------------------------------------------------------
OPENSEARCH_URL=https://os-shelfsync-your-project.aivencloud.com:15686
OPENSEARCH_USERNAME=avnadmin
OPENSEARCH_PASSWORD=your_aiven_opensearch_password
OPENSEARCH_INDEX=shelfsync_products

# ------------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_shelfsync_2026_cse_student_project_min_32_chars
JWT_EXPIRES_IN=7d
SESSION_SECRET=super_secret_session_key_shelfsync_inr_ecommerce

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI API (For WhatsApp AI Product Discovery)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key

# ------------------------------------------------------------------------------
# 6. RAZORPAY PAYMENT GATEWAY (Sandbox or Live)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_sandbox_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 7. META WHATSAPP BUSINESS CLOUD API
# ------------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_VERIFY_TOKEN=shelfsync_secure_webhook_verify_token_2026
